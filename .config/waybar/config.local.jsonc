{
    "modules-right": [
        "custom/jellyfin-status",
        "custom/apt-status",
        "pulseaudio",
        "clock",
        "tray"
    ],
    "custom/jellyfin-status": {
        "exec": "~/.config/waybar/scripts/page-status.sh jellyfin.seemyvest.net",
        "return-type": "json",
        "format": "{icon}",
        "tooltip": "jellyfin.seemyvest.net down",
        "hide-empty-text": true,
        "interval": 30,
        "on-click": "sensible-browser https://jellyfin.seemyvest.net",
        "on-click-right": "foot ssh gargantua-two",
        "format-icons": {
            "down": "",
        },
    },
    "custom/apt-status": {
        "exec": "~/.config/waybar/scripts/page-status.sh apt.seemyvest.net",
        "return-type": "json",
        "format": "{icon}",
        "tooltip": "apt.seemyvest.net down",
        "hide-empty-text": true,
        "interval": 30,
        "on-click": "sensible-browser https://apt.seemyvest.net",
        "on-click-right": "foot ssh gargantua-two",
        "format-icons": {
            "down": "",
        },
    }
}
