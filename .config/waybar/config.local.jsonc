{
    "modules-right": [
        "custom/maildir",
        "custom/systemd-status",
        "custom/gargantua-two-status",
        "custom/jellyfin-status",
        "custom/apt-status",
        "bluetooth",
        "wireplumber",
        "clock",
        "tray"
    ],
    "custom/gargantua-two-status": {
        "exec": "~/.config/waybar/scripts/ssh-status gargantua-two systemctl --failed --legend=no",
        "return-type": "json",
        "format": "{icon}",
        "hide-empty-text": true,
        "interval": 30,
        "on-click": "footclient ssh -t gargantua-two 'systemctl --failed; bash -i'",
        "format-icons": {
            "down": "⬡",
            "nodata": "⬡",
        },
    },
    "custom/jellyfin-status": {
        "exec": "~/.config/waybar/scripts/page-status jellyfin.seemyvest.net",
        "return-type": "json",
        "format": "{icon}",
        "tooltip": "jellyfin.seemyvest.net down",
        "hide-empty-text": true,
        "interval": 30,
        "on-click": "sensible-browser https://jellyfin.seemyvest.net",
        "on-click-right": "footclient ssh gargantua-two",
        "format-icons": {
            "down": "",
        },
    },
    "custom/apt-status": {
        "exec": "~/.config/waybar/scripts/page-status apt.seemyvest.net",
        "return-type": "json",
        "format": "{icon}",
        "tooltip": "apt.seemyvest.net down",
        "hide-empty-text": true,
        "interval": 30,
        "on-click": "sensible-browser https://apt.seemyvest.net",
        "on-click-right": "footclient ssh gargantua-two",
        "format-icons": {
            "down": "",
        },
    }
}
