{
    "modules-right": [
        "custom/madagascar-status",
        "custom/gargantua-two-status",
        "custom/jellyfin-status",
        "custom/apt-status",
        "wireplumber",
        "clock",
        "tray"
    ],
    "custom/madagascar-status": {
        "exec": "systemctl --user --failed --legend=no | grep -q . && echo '{\"text\": \"down\", \"alt\": \"down\", \"tooltip\": \"systemd service down\"}'",
        "return-type": "json",
        "format": "{icon}",
        "hide-empty-text": true,
        "interval": 30,
        "on-click": "foot",
        "format-icons": {
            "down": "⏻",
        },
    },
    "custom/gargantua-two-status": {
        "exec": "ssh gargantua-two systemctl --failed --legend=no | grep -q . && echo '{\"text\": \"down\", \"alt\": \"down\", \"tooltip\": \"service down on gargantua-two\"}'",
        "return-type": "json",
        "format": "{icon}",
        "hide-empty-text": true,
        "interval": 30,
        "on-click": "foot ssh gargantua-two",
        "format-icons": {
            "down": "⬡",
        },
    },
    "custom/jellyfin-status": {
        "exec": "~/.config/waybar/scripts/page-status.sh jellyfin.seemyvest.net",
        "return-type": "json",
        "format": "{icon}",
        "tooltip": "jellyfin.seemyvest.net down",
        "hide-empty-text": true,
        "interval": 30,
        "on-click": "sensible-browser https://jellyfin.seemyvest.net",
        "on-click-right": "foot ssh gargantua-two",
        "format-icons": {
            "down": "",
        },
    },
    "custom/apt-status": {
        "exec": "~/.config/waybar/scripts/page-status.sh apt.seemyvest.net",
        "return-type": "json",
        "format": "{icon}",
        "tooltip": "apt.seemyvest.net down",
        "hide-empty-text": true,
        "interval": 30,
        "on-click": "sensible-browser https://apt.seemyvest.net",
        "on-click-right": "foot ssh gargantua-two",
        "format-icons": {
            "down": "",
        },
    }
}
